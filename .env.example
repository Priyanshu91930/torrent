# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Admin Users (comma-separated Telegram user IDs) ───────────────────────────
ADMIN_IDS=123456789,987654321

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CALLS=5
RATE_LIMIT_PERIOD=60

# ── Scraper Settings ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15
MAX_RETRIES=3
MAX_RESULTS=50
RESULTS_PER_PAGE=5
SCRAPER_CONCURRENCY=5

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL=600
CACHE_MAX_SIZE=200
CACHE_DIR=cache

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/torrentbot.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ── Proxy (optional, for bypassing geo-blocks) ────────────────────────────────
# HTTP_PROXY=http://user:pass@proxy-host:port

# ── Torrent Site URLs (change if sites move to new domains) ──────────────────
TAMILMV_URL=https://www.1tamilmv.futbol
NYAA_URL=https://nyaa.si
YTS_API_URL=https://yts.mx/api/v2
TORRENTGALAXY_URL=https://torrentgalaxy.to
PIRATEBAY_URL=https://thepiratebay.org
